{
  "name": "masterworld",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Classic fantasy RPG in the browser with a virtual game master that builds the world as play needs it.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "packs": "node tools/packs/actors.mjs && node tools/packs/library.mjs && node tools/packs/bundle.mjs",
    "props": "node tools/props/pack.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test/run.mjs",
    "guards": "node tools/guards/guards.mjs",
    "dup": "node tools/duplicate-candidates/find-duplicate-candidates.mjs",
    "repeated": "node tools/repeated-code/find-repeated-code.mjs",
    "shot": "node tools/shot/shot.mjs",
    "load": "node tools/shot/load.mjs",
    "shot:set": "node tools/shot/set.mjs",
    "shot:set:town": "node tools/shot/set.mjs shots/set --part=town",
    "shot:set:land": "node tools/shot/set.mjs shots/set --part=land",
    "preview:caves": "node tools/preview/formed.mjs",
    "shot:set:caves": "node tools/shot/set.mjs shots/set --part=caves",
    "shot:set:kinds": "node tools/shot/set.mjs shots/set --part=kinds",
    "shot:set:sea": "node tools/shot/set.mjs shots/set --part=sea",
    "shot:set:ships": "node tools/shot/set.mjs shots/set --part=ships",
    "shot:origin": "node tools/shot/origin.mjs",
    "shot:spells": "node tools/shot/spells.mjs",
    "shot:rest": "node tools/shot/rest.mjs",
    "shot:events": "node tools/shot/events.mjs",
    "shot:sights": "node tools/shot/sights.mjs",
    "shot:hits": "node tools/shot/hits.mjs",
    "shot:limp": "node tools/shot/limp.mjs",
    "variety": "node --import tsx tools/variety/cellars.ts",
    "zfight": "node --import tsx tools/zfight/scan.ts",
    "ground:scan": "node --import tsx tools/ground/scan.ts",
    "loop": "node --import tsx tools/loop/evening.ts && node --import tsx tools/loop/voyage.ts",
    "water:fit": "node --import tsx tools/water/fit.ts",
    "walk:landforms": "node --import tsx tools/loop/landformWalk.ts masterworld && node --import tsx tools/loop/landformWalk.ts alpha && node --import tsx tools/loop/landformWalk.ts x4",
    "check:units": "node tools/units/check.mjs",
    "shot:spellfx": "node tools/shot/spellfx.mjs",
    "shot:hatch": "node tools/shot/hatch.mjs",
    "shot:climb": "node tools/shot/climb.mjs",
    "shot:doors": "node tools/shot/doors.mjs",
    "shot:search": "node tools/shot/search.mjs",
    "shot:owner": "node tools/shot/owner.mjs",
    "shot:asks": "node tools/shot/asks.mjs",
    "shot:ways": "node tools/shot/ways.mjs",
    "shot:mouths": "node tools/shot/mouths.mjs",
    "shot:capital": "node tools/shot/capital.mjs",
    "shot:quest": "node tools/shot/quest.mjs",
    "shot:learning": "node tools/shot/learning.mjs",
    "shot:handover": "node tools/shot/handover.mjs",
    "shot:goto": "node tools/shot/goto.mjs",
    "shot:grounded": "node tools/shot/grounded.mjs",
    "shot:hitches": "node tools/shot/hitches.mjs",
    "shot:holdfight": "node tools/shot/holdfight.mjs",
    "shot:vgm": "node tools/shot/vgm.mjs",
    "shot:stone": "node tools/shot/stone.mjs"
  },
  "dependencies": {
    "@actors/animal": "https://github.com/ArndRosemeier/Actors/releases/download/v0.20.0/actors-animal-0.20.0.tgz",
    "@actors/generator": "https://github.com/ArndRosemeier/Actors/releases/download/v0.20.0/actors-generator-0.20.0.tgz",
    "@futuremagic/audio": "file:vendor/assetgenerator/packages/audio",
    "@futuremagic/core": "file:vendor/assetgenerator/packages/core",
    "@futuremagic/creatures": "file:vendor/assetgenerator/packages/creatures",
    "@futuremagic/dungeon": "file:vendor/assetgenerator/packages/dungeon",
    "@futuremagic/figure": "file:vendor/assetgenerator/packages/figure",
    "@futuremagic/instances": "file:vendor/assetgenerator/packages/instances",
    "@futuremagic/props": "file:vendor/assetgenerator/packages/props",
    "@futuremagic/rocks": "file:vendor/assetgenerator/packages/rocks",
    "@futuremagic/settlement": "file:vendor/assetgenerator/packages/settlement",
    "@futuremagic/sky": "file:vendor/assetgenerator/packages/sky",
    "@futuremagic/stage": "file:vendor/assetgenerator/packages/stage",
    "@futuremagic/texgen": "file:vendor/assetgenerator/packages/texgen",
    "@futuremagic/vegetation": "file:vendor/assetgenerator/packages/vegetation",
    "@futuremagic/volume": "file:vendor/assetgenerator/packages/volume",
    "solarpolis-dialogue": "https://github.com/ArndRosemeier/Conversations/releases/download/v0.1.0/solarpolis-dialogue-0.1.0.tgz",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.1"
  }
}
